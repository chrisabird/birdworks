---
/**
 * Renders a product photograph, or — until photography exists — a labelled
 * placeholder at the final aspect ratio that states what needs shooting.
 * Swapping in a real photo is a one-line frontmatter change.
 */
interface Props {
  src?: string | undefined;
  alt?: string | undefined;
  ratio?: string;
  shot?: string;
  class?: string;
  eager?: boolean;
}

const {
  src,
  alt = '',
  ratio = '4 / 3',
  shot = 'Photograph',
  class: className,
  eager = false,
} = Astro.props;
---

{
  src ? (
    <img
      class:list={['figure', className]}
      src={src}
      alt={alt}
      style={`aspect-ratio: ${ratio}`}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  ) : (
    <div
      class:list={['figure', 'placeholder', className]}
      style={`aspect-ratio: ${ratio}`}
      role="img"
      aria-label={`Placeholder: ${shot}`}
    >
      <span class="placeholder-mark" aria-hidden="true">
        ◻
      </span>
      <span class="placeholder-shot">{shot}</span>
      <span class="placeholder-ratio">{ratio.replace(/\s/g, '')}</span>
    </div>
  )
}

<style>
  .figure {
    width: 100%;
    object-fit: cover;
    background: var(--washi-2);
  }

  .placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    padding: var(--space-m);
    text-align: center;
    background: color-mix(in srgb, var(--fg) 5%, transparent);
    border: 1px dashed color-mix(in srgb, var(--fg) 22%, transparent);
    color: var(--muted);
  }

  .placeholder-mark {
    font-size: 1.5rem;
    color: color-mix(in srgb, var(--shu) 55%, transparent);
  }

  .placeholder-shot {
    max-width: 26ch;
    font-size: var(--step--1);
    font-weight: 500;
    line-height: 1.4;
  }

  .placeholder-ratio {
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.6;
  }
</style>
