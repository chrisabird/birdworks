---
import { formatPrice, site } from '../site';

interface Props {
  title: string;
  price?: number | null;
  currency?: string;
  postage?: number | null;
  postageLabel?: string;
  leadTime?: string | null;
  buyButtonId?: string | null;
  publishableKey?: string | null;
  parts: Array<{ name: string; role: string; colourable: boolean }>;
  colours: Array<{ name: string; hex: string; stripeBuyButtonId: string | null }>;
}

const {
  title,
  price,
  currency = 'GBP',
  postage,
  postageLabel = 'UK delivery',
  leadTime,
  buyButtonId,
  publishableKey,
  parts,
  colours,
} = Astro.props;

const colourable = parts.filter((p) => p.colourable);

/**
 * One coloured part means few enough options for a Stripe buy button each,
 * picked on the page. More than one multiplies out, so colours are chosen in
 * Stripe checkout custom fields against a single button.
 */
const single = colourable.length === 1 && colours.length > 0 ? colourable[0] : undefined;

const configured = Boolean(buyButtonId && publishableKey);
const options = colours.map((c) => ({
  ...c,
  live: Boolean(c.stripeBuyButtonId && publishableKey),
}));
const loadStripe = single ? options.some((o) => o.live) : configured;
---

<section class="buy section" id="buy">
  <div class="wrap">
    <div class="panel reveal">
      <div class="col">
        <p class="label label-accent">Order</p>
        <h2>{title}</h2>

        <p class="price">
          {formatPrice(price ?? null, currency)}
        </p>

        <ul class="terms" role="list">
          <li>
            {
              postage === null || postage === undefined
                ? `${postageLabel} — rate TBC`
                : postage === 0
                  ? `Free ${postageLabel.toLowerCase()}`
                  : `${formatPrice(postage, currency)} ${postageLabel.toLowerCase()} · ${site.shipping.carrier}`
            }
          </li>
          <li>{leadTime ? `Made to order — ${leadTime}` : 'Made to order — lead time TBC'}</li>
          <li>{site.shipping.region}</li>
          <li>
            <a href="/returns/">14-day right to cancel</a>
          </li>
        </ul>
      </div>

      <div class="col">
        {
          single ? (
            <div class="picker" data-picker>
              <fieldset>
                <legend class="note-head">
                  Choose your {single.name.toLowerCase()}
                </legend>
                <div class="choices">
                  {options.map((o, i) => (
                    <label class="choice">
                      <input
                        type="radio"
                        name="colour"
                        value={String(i)}
                        checked={i === 0}
                      />
                      <span class="chip" style={`--chip: ${o.hex}`} aria-hidden="true" />
                      <span>{o.name}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
              <p class="note">Everything is printed after you order.</p>

              {options.map((o, i) => (
                <div data-option={String(i)} hidden={i !== 0}>
                  {o.live ? (
                    <stripe-buy-button
                      buy-button-id={o.stripeBuyButtonId}
                      publishable-key={publishableKey}
                    />
                  ) : (
                    <div class="pending">
                      <p class="pending-head">{o.name} — not yet on sale</p>
                      <p>
                        The Stripe buy button for this colour appears here once
                        it is configured. See PLAN.md §9.
                      </p>
                    </div>
                  )}
                </div>
              ))}
            </div>
          ) : (
            colourable.length > 0 && (
              <div class="note">
                <p class="note-head">Choosing your colours</p>
                <p>
                  You pick a colour for each of the {colourable.length} parts
                  during checkout —{' '}
                  {colourable.map((p) => p.name.toLowerCase()).join(', ')}.
                  Everything is printed after you order.
                </p>
              </div>
            )
          )
        }

        {
          single ? null : configured ? (
            <stripe-buy-button
              buy-button-id={buyButtonId}
              publishable-key={publishableKey}
            />
          ) : (
            <div class="pending">
              <p class="pending-head">Not yet on sale</p>
              <p>
                The Stripe buy button appears here once the product is
                configured. See PLAN.md §9.
              </p>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

{loadStripe && <script async src="https://js.stripe.com/v3/buy-button.js" is:inline />}

<script>
  // Show the buy button for the selected colour.
  for (const picker of document.querySelectorAll<HTMLElement>('[data-picker]')) {
    picker.addEventListener('change', (e) => {
      const value = (e.target as HTMLInputElement).value;
      for (const option of picker.querySelectorAll<HTMLElement>('[data-option]')) {
        option.hidden = option.dataset.option !== value;
      }
    });
  }
</script>

<style>
  .panel {
    display: grid;
    gap: var(--space-xl);
    padding: var(--space-xl) 0 0;
    border-top: 2px solid var(--fg);
  }

  @media (min-width: 52rem) {
    .panel {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-2xl);
    }
  }

  h2 {
    font-size: var(--step-2);
    margin-bottom: var(--space-s);
  }

  .price {
    font-size: var(--step-2);
    font-weight: 620;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-m);
  }

  .terms {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3xs);
    font-size: var(--step--1);
    color: var(--muted);
  }

  .note {
    margin-bottom: var(--space-l);
    font-size: var(--step--1);
    color: var(--muted);
    line-height: 1.6;
  }

  .note-head {
    font-weight: 560;
    color: var(--fg);
    margin-bottom: var(--space-3xs);
  }

  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
  }

  .choices {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block: var(--space-xs) var(--space-s);
  }

  .choice {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-3xs) var(--space-xs);
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: var(--step--1);
    cursor: pointer;
  }

  .choice:has(input:checked) {
    border-color: var(--fg);
  }

  .choice:has(input:focus-visible) {
    outline: 2px solid var(--shu);
    outline-offset: 2px;
  }

  .choice input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .chip {
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: var(--chip);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--fg) 22%, transparent);
  }

  .pending {
    padding: var(--space-m);
    border: 1px dashed var(--rule);
    font-size: var(--step--1);
    color: var(--muted);
  }

  .pending-head {
    font-weight: 560;
    color: var(--fg);
    margin-bottom: var(--space-3xs);
  }
</style>
