---
import Base from './Base.astro';

interface Props {
  title: string;
  description?: string;
  standfirst?: string;
  updated?: string;
}

const { title, description, standfirst, updated } = Astro.props;
---

<Base title={title} description={description ?? standfirst}>
  <article class="section-tight">
    <div class="wrap">
      <header class="head">
        <h1>{title}</h1>
        {standfirst && <p class="lede">{standfirst}</p>}
        {updated && <p class="updated">Last updated {updated}</p>}
      </header>

      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</Base>

<style>
  .head {
    max-width: 24ch;
    margin-bottom: var(--space-xl);
  }

  h1 {
    font-size: var(--step-3);
    margin-bottom: var(--space-m);
  }

  .lede {
    color: var(--muted);
    max-width: 34ch;
  }

  .updated {
    margin-top: var(--space-s);
    font-size: var(--step--1);
    color: var(--muted);
  }

  .prose {
    max-width: var(--measure);
  }

  .prose :global(h2) {
    font-size: var(--step-1);
    margin-block: var(--space-xl) var(--space-s);
  }

  .prose :global(h3) {
    font-size: var(--step-0);
    font-weight: 600;
    margin-block: var(--space-l) var(--space-2xs);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 var(--space-m);
    padding-left: 1.2em;
  }

  .prose :global(li) {
    margin-bottom: var(--space-2xs);
  }

  .prose :global(dl) {
    margin: 0 0 var(--space-m);
  }

  .prose :global(dt) {
    font-weight: 560;
  }

  .prose :global(dd) {
    margin: 0 0 var(--space-s);
    color: var(--muted);
  }

  .prose :global(.tbd) {
    padding: var(--space-2xs) var(--space-xs);
    background: color-mix(in srgb, var(--shu) 12%, transparent);
    box-shadow: inset 2px 0 0 var(--shu);
    display: inline-block;
  }
</style>
